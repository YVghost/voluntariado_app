<%# ── Secciones de convocatoria para voluntarios ── %>
<% if current_user.voluntario? && current_user.profile_complete? %>

  <%# Convocatorias directas %>
  <% if @convocados.present? %>
    <div class="mb-6 rounded-2xl bg-wine-900 p-6 shadow-lg">
      <div class="flex items-center gap-3 mb-4">
        <div class="h-8 w-8 rounded-full bg-red-500 flex items-center justify-center" style="animation: pulse 2s infinite;">
          <span style="color:white; font-weight:bold; font-size:0.9rem;">!</span>
        </div>
        <h2 class="font-bold text-lg" style="color:white;">Fuiste convocado a <%= @convocados.count %> <%= @convocados.count == 1 ? 'emergencia' : 'emergencias' %></h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @convocados.each do |event| %>
          <div class="rounded-xl border border-wine-700 bg-wine-800 p-4 hover:bg-wine-700 transition-colors">
            <div class="flex items-start justify-between mb-2">
              <h3 class="font-semibold text-sm leading-snug" style="color:white;"><%= event.title %></h3>
              <span class="ml-2 shrink-0 rounded-full bg-red-500 px-2 py-0.5 text-xs font-bold" style="color:white;">T<%= event.emergency_level %></span>
            </div>
            <p class="text-xs mb-3" style="color:#fca5a5;">📍 <%= event.location %></p>
            <p class="text-xs mb-3" style="color:#fca5a5;">📅 <%= event.date&.strftime("%d/%m/%Y %H:%M") %></p>
            <%= link_to "Ver emergencia →", event, class: "text-sm font-semibold hover:opacity-80 transition-colors", style: "color:#fecaca;" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Segunda ola (misiones internacionales) %>
  <% if @segunda_ola.present? %>
    <div class="mb-6 rounded-2xl border-2 border-blue-300 bg-blue-50 p-5">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xl">🌐</span>
        <h2 class="font-semibold text-blue-900">Convocatoria internacional — Segunda ola</h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @segunda_ola.each do |event| %>
          <% enrollment = current_user.enrollments.find_by(event: event) %>
          <div class="rounded-xl border border-blue-200 bg-white p-4">
            <div class="flex items-start justify-between mb-1">
              <h3 class="font-semibold text-slate-800 text-sm"><%= event.title %></h3>
              <span class="ml-2 shrink-0 rounded-full bg-blue-100 px-2 py-0.5 text-xs font-bold text-blue-800">T<%= event.emergency_level %></span>
            </div>
            <p class="text-xs text-slate-500 mb-1">📍 <%= event.location %></p>
            <% if enrollment&.expected_arrival %>
              <p class="text-xs text-blue-700 font-medium mb-2">Llegada estimada: <%= enrollment.expected_arrival.strftime("%d/%m/%Y") %></p>
            <% end %>
            <%= link_to "Ver detalles →", event, class: "text-xs font-semibold text-blue-700 hover:text-blue-900 transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Emergencias donde puede sumarse como apoyo %>
  <% if @disponibles.present? %>
    <div class="mb-6 rounded-2xl border-2 border-orange-200 bg-orange-50 p-5">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg">🤝</span>
        <h2 class="font-semibold text-orange-900">Podés sumarte como apoyo</h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <% @disponibles.each do |event| %>
          <div class="flex items-center justify-between rounded-lg border border-orange-200 bg-white px-4 py-3 hover:shadow-sm transition-all">
            <div>
              <p class="font-medium text-slate-800 text-sm"><%= event.title %></p>
              <p class="text-xs text-orange-700 mt-0.5">📍 <%= event.location %></p>
            </div>
            <div class="flex items-center gap-2 shrink-0 ml-3">
              <span class="rounded-full bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-800">T<%= event.emergency_level %></span>
              <%= link_to "Ver →", event, class: "text-xs font-semibold text-wine-700 hover:text-wine-900 transition-colors" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

<% end %>

<%# Header de página %>
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Eventos</h1>
    <p class="text-sm text-slate-500 mt-0.5"><%= @events.count %> <%= @events.count == 1 ? 'evento' : 'eventos' %> registrados</p>
  </div>
  <% if policy(Event).create? %>
    <%= link_to "＋ Nuevo evento", new_event_path,
          class: "rounded-xl bg-wine-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-wine-700 transition-colors shadow-sm" %>
  <% end %>
</div>

<%
  volunteer_profile = current_user&.voluntario? ? current_user.volunteer_profile : nil

  if current_user&.voluntario?
    enrolled_event_ids = current_user.enrollments.where.not(status: :cancelado).pluck(:event_id)
    convoked_event_ids = current_user.enrollments.where(status: [:convocado, :confirmado]).pluck(:event_id)
  else
    enrolled_event_ids = []
    convoked_event_ids = []
  end
%>

<% if @events.empty? %>
  <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center">
    <div class="mx-auto h-16 w-16 rounded-full bg-slate-100 flex items-center justify-center mb-4 text-3xl">
      📅
    </div>
    <p class="text-slate-500 font-medium">No hay eventos registrados</p>
    <p class="text-slate-400 text-sm mt-1">Los eventos aparecerán aquí cuando se creen.</p>
  </div>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @events.each do |event| %>
      <%
        is_enrolled   = enrolled_event_ids.include?(event.id)
        is_convoked   = convoked_event_ids.include?(event.id)
        is_emergency  = event.emergency_level.present?

        # Solo calculamos tier si el voluntario NO está inscrito y es una emergencia
        vol_tier = if volunteer_profile && is_emergency && !is_enrolled
          volunteer_profile.tier_for_event(event)
        end

        # Estado de la card para este voluntario
        card_state = if is_convoked
          :convoked        # ya convocado o confirmado → amber
        elsif vol_tier == :immediate
          :immediate       # puede inscribirse directamente → verde
        elsif vol_tier == :support
          :support         # puede dar apoyo → naranja
        elsif volunteer_profile && is_emergency && !is_enrolled
          :out_of_range    # no tiene capacidad para esta emergencia → gris
        else
          :normal          # evento normal o no es voluntario → blanco
        end

        # Colores inline (evita que Tailwind no genere clases dinámicas)
        card_style = case card_state
        when :convoked     then "background:#fef3c7; border:1px solid #f59e0b;"   # amber
        when :immediate    then "background:#dcfce7; border:1px solid #16a34a;"   # green
        when :support      then "background:#ffedd5; border:1px solid #ea580c;"   # orange
        when :out_of_range then "background:#f1f5f9; border:1px solid #cbd5e1;"   # slate
        else                    "background:#ffffff;  border:1px solid #e2e8f0;"  # white
        end

        meta_color    = case card_state
        when :convoked     then "color:#92400e;"
        when :immediate    then "color:#166534;"
        when :support      then "color:#9a3412;"
        when :out_of_range then "color:#94a3b8;"
        else                    "color:#94a3b8;"
        end

        divider_color = case card_state
        when :convoked     then "border-color:#fcd34d;"
        when :immediate    then "border-color:#86efac;"
        when :support      then "border-color:#fdba74;"
        else                    "border-color:#f1f5f9;"
        end

        border_left_color = if is_emergency
          case event.emergency_level
          when 1 then "#4ade80"
          when 2 then "#a3e635"
          when 3 then "#facc15"
          when 4 then "#f97316"
          when 5 then "#ef4444"
          when 6 then "#e11d48"
          else        "#cbd5e1"
          end
        elsif event.en_curso? then "#fbbf24"
        elsif event.activo?   then "#4ade80"
        else                       "#cbd5e1"
        end
      %>

      <div class="rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col"
           style="<%= card_style %> border-left: 4px solid <%= border_left_color %>;">
        <div class="p-5 flex-1">

          <%# Badge de estado para voluntarios %>
          <% if card_state != :normal %>
            <div class="mb-3">
              <% case card_state %>
              <% when :convoked %>
                <span class="rounded-full px-2.5 py-0.5 text-xs font-bold" style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5;">🚨 Ya convocado</span>
              <% when :immediate %>
                <span class="rounded-full bg-green-600 px-2.5 py-0.5 text-xs font-bold" style="color:white;">✓ Podés inscribirte</span>
              <% when :support %>
                <span class="rounded-full bg-orange-500 px-2.5 py-0.5 text-xs font-bold" style="color:white;">🤝 Podés dar apoyo</span>
              <% when :out_of_range %>
                <span class="rounded-full bg-slate-400 px-2.5 py-0.5 text-xs font-medium" style="color:white;">Sin nivel requerido</span>
              <% end %>
            </div>
          <% end %>

          <div class="flex items-start justify-between gap-3 mb-3">
            <h2 class="font-semibold text-base leading-snug line-clamp-2 text-slate-900"><%= event.title %></h2>
            <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold
              <%= event.activo?   ? 'bg-green-100 text-green-800' :
                  event.en_curso? ? 'bg-amber-100 text-amber-800' :
                                    'bg-slate-100 text-slate-600' %>">
              <%= event.activo? ? "Convocando" : event.en_curso? ? "En curso" : "Finalizado" %>
            </span>
          </div>

          <% if event.emergency_level.present? %>
            <div class="flex items-center gap-2 mb-3">
              <span class="rounded-lg px-2.5 py-1 text-xs font-bold
                <%= event.emergency_level >= 5 ? 'bg-red-100 text-red-800' :
                    event.emergency_level >= 3 ? 'bg-orange-100 text-orange-800' :
                                                 'bg-yellow-100 text-yellow-800' %>">
                T<%= event.emergency_level %> — <%= ["","Leve","Moderada","Media","Alta","Crítica","Catástrofe"][event.emergency_level] %>
              </span>
              <% if event.emergency_type.present? %>
                <span class="text-xs text-slate-500 capitalize"><%= event.emergency_type %></span>
              <% end %>
            </div>
          <% end %>

          <p class="text-sm text-slate-500 line-clamp-2 mb-4"><%= event.description %></p>

          <div class="space-y-1.5">
            <% if event.date.present? %>
              <div class="flex items-center gap-2 text-xs" style="<%= meta_color %>">
                <span class="shrink-0">📅</span>
                <%= event.date.strftime("%d/%m/%Y — %H:%M") %>
              </div>
            <% end %>
            <% if event.location.present? %>
              <div class="flex items-center gap-2 text-xs" style="<%= meta_color %>">
                <span class="shrink-0">📍</span>
                <%= event.location %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="px-5 pb-4 pt-3 border-t" style="<%= divider_color %>">
          <%= link_to "Ver evento →", event,
                class: "text-sm font-semibold text-wine-800 hover:text-wine-600 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
