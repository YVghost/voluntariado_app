<%# ── Org/Admin: lista completa + chat ── %>
<% if policy(event).update? %>

  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <div class="h-2.5 w-2.5 rounded-full bg-amber-500" style="animation:pulse 2s infinite;"></div>
      <p class="text-sm font-semibold text-slate-700">Evento en curso — tomando lista de asistencia</p>
    </div>
    <%= button_to "✓ Dar por finalizado", finalizar_event_path(event), method: :patch,
        data: { turbo_confirm: "¿Finalizar el evento? Podrás calificar a los voluntarios que asistieron." },
        class: "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-all cursor-pointer shadow-sm" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">

    <%# Lista completa de voluntarios %>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-semibold text-slate-800">
          👥 Lista de voluntarios
        </h2>
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
          <%= event.enrollments.where(status: :asistio).count %> /
          <%= event.enrollments.where.not(status: :cancelado).count %> asistieron
        </span>
      </div>
      <div id="volunteers_list" class="divide-y divide-slate-100 max-h-[520px] overflow-y-auto">
        <% enrolled = event.enrollments.includes(user: :volunteer_profile)
                           .where.not(status: :cancelado)
                           .order(Arel.sql("CASE status WHEN 2 THEN 0 WHEN 1 THEN 1 WHEN 0 THEN 2 ELSE 3 END")) %>
        <% if enrolled.any? %>
          <%= render enrolled, event: event %>
        <% else %>
          <p class="text-sm text-slate-400 py-10 text-center">Sin voluntarios registrados.</p>
        <% end %>
      </div>
    </div>

    <%# Chat %>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm flex flex-col">
      <div class="px-5 py-4 border-b border-slate-100">
        <h2 class="font-semibold text-slate-800">💬 Chat del evento</h2>
      </div>
      <%= turbo_stream_from event, :chat %>
      <div id="messages" class="flex flex-col gap-3 p-5 min-h-64 max-h-[420px] overflow-y-auto flex-1">
        <%= render event.messages.order(:created_at) %>
      </div>
      <div class="px-5 py-4 border-t border-slate-100">
        <%= render "events/message_form", event: event %>
      </div>
    </div>

  </div>

  <div class="pt-4 border-t border-slate-200">
    <%= link_to "← Volver a eventos", events_path, class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
  </div>

<%# ── Voluntario: su estado + chat ── %>
<% else %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="lg:col-span-1">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="font-semibold text-slate-800 mb-4">Tu inscripción</h2>
        <%= render "events/enrollment_section",
              event: event,
              enrollment: event.enrollments.find_by(user: current_user) %>
      </div>
    </div>
    <div class="lg:col-span-2">
      <div class="rounded-2xl border border-slate-200 bg-white shadow-sm flex flex-col h-full">
        <div class="px-5 py-4 border-b border-slate-100">
          <h2 class="font-semibold text-slate-800">💬 Chat del evento</h2>
        </div>
        <%= turbo_stream_from event, :chat %>
        <div id="messages" class="flex flex-col gap-3 p-5 min-h-48 max-h-80 overflow-y-auto">
          <%= render event.messages.order(:created_at) %>
        </div>
        <div class="px-5 py-4 border-t border-slate-100">
          <%= render "events/message_form", event: event %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to "← Volver a eventos", events_path, class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
  </div>

<% end %>
