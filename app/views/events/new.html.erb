<div class="max-w-5xl mx-auto">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Nuevo evento</h1>
      <p class="text-sm text-slate-500 mt-1">Completá los datos del evento. Los campos de emergencia son opcionales para eventos normales.</p>
    </div>
    <%= link_to "← Volver a eventos", events_path, class: "text-sm text-slate-500 hover:text-slate-700 transition-colors shrink-0" %>
  </div>
  <%= render "form", event: @event %>
</div>
