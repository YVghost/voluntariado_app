<%# ── Org/Admin: calificación uno a uno ── %>
<% if policy(event).update? %>

  <% attendees = event.enrollments.where(status: :asistio).includes(:user, :review, user: :volunteer_profile) %>

  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-sm text-slate-500">
        <%= attendees.count %> <%= attendees.count == 1 ? 'voluntario asistió' : 'voluntarios asistieron' %> —
        <%= attendees.select { |e| e.review.present? }.count %> calificados,
        <%= attendees.reject { |e| e.review.present? }.count %> pendientes
      </p>
    </div>
    <%= link_to "← Volver a eventos", events_path,
          class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
  </div>

  <% if attendees.empty? %>
    <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center">
      <p class="text-slate-500 font-medium">No hay voluntarios con asistencia registrada</p>
      <p class="text-slate-400 text-sm mt-1">Nadie fue marcado como asistido en este evento.</p>
    </div>

  <% else %>
    <%# Leyenda de escala global %>
    <div class="mb-4 flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white px-5 py-3 text-xs text-slate-500 shadow-sm">
      <span class="font-semibold text-slate-600 shrink-0">Escala de calificación:</span>
      <% [["0","No aplicó","#e2e8f0","#475569"],["1","Básico","#dbeafe","#1d4ed8"],["2","Moderado","#fef9c3","#854d0e"],["3","Avanzado","#ffedd5","#9a3412"],["4","Experto","#dcfce7","#166534"]].each do |v,l,bg,fg| %>
        <span class="rounded-full px-2.5 py-0.5 font-semibold" style="background:<%= bg %>; color:<%= fg %>;"><%= v %> — <%= l %></span>
      <% end %>
    </div>

    <div class="space-y-3">
      <% attendees.each do |enrollment| %>
        <details id="enrollment_review_<%= enrollment.id %>"
                 class="rounded-2xl shadow-sm overflow-hidden"
                 style="border: 1px solid <%= enrollment.review ? '#86efac' : '#e2e8f0' %>;">

          <%# ── Cabecera (siempre visible) ── %>
          <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer select-none"
                   style="background:<%= enrollment.review ? '#f0fdf4' : '#ffffff' %>; list-style:none;">
            <div class="flex items-center gap-3 min-w-0">
              <div class="h-10 w-10 rounded-full flex items-center justify-center text-sm font-bold shrink-0"
                   style="background:#ede9fe; color:#6d28d9;">
                <%= enrollment.user.name&.first&.upcase || "?" %>
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-slate-900 truncate"><%= enrollment.user.name %></p>
                <% if (vp = enrollment.user.volunteer_profile) %>
                  <div class="flex gap-1 mt-1 flex-wrap">
                    <% vp.skills.first(3).each do |s| %>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">
                        <%= VolunteerProfile::SKILL_LABELS[s]&.split(" ")&.first || s %>
                      </span>
                    <% end %>
                    <span class="rounded-md px-2 py-0.5 text-xs font-bold"
                          style="background:<%= vp.score >= 7 ? '#dcfce7' : vp.score >= 5 ? '#fef9c3' : '#fee2e2' %>;
                                 color:<%= vp.score >= 7 ? '#166534' : vp.score >= 5 ? '#854d0e' : '#991b1b' %>;">
                      <%= vp.score %>/10
                    </span>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <% if enrollment.review %>
                <span class="rounded-full px-3 py-1 text-xs font-semibold" style="background:#16a34a; color:white;">✓ Calificado</span>
              <% else %>
                <span class="rounded-full px-3 py-1 text-xs font-semibold" style="background:#fef3c7; color:#92400e;">Pendiente ▾</span>
              <% end %>
            </div>
          </summary>

          <%# ── Cuerpo expandible ── %>
          <div class="px-6 py-5 border-t"
               style="border-color:<%= enrollment.review ? '#bbf7d0' : '#f1f5f9' %>;
                      background:<%= enrollment.review ? '#f0fdf4' : '#fafafa' %>;">

            <% if enrollment.review %>
              <%# Ya calificado — muestra resumen de scores %>
              <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-3">
                <% EnrollmentReview::SKILL_ATTRS.each do |attr| %>
                  <% val = enrollment.review.send(attr) %>
                  <%
                    pill_bg = val >= 4 ? "#dcfce7" : val >= 3 ? "#ffedd5" : val >= 2 ? "#fef9c3" : val >= 1 ? "#dbeafe" : "#e2e8f0"
                    pill_fg = val >= 4 ? "#166534" : val >= 3 ? "#9a3412" : val >= 2 ? "#854d0e" : val >= 1 ? "#1d4ed8" : "#475569"
                  %>
                  <div class="rounded-xl p-3 text-center" style="background:<%= pill_bg %>;">
                    <p class="text-2xl font-extrabold leading-none" style="color:<%= pill_fg %>;"><%= val %></p>
                    <p class="text-xs mt-1 leading-tight" style="color:<%= pill_fg %>; opacity:0.8;">
                      <%= EnrollmentReview::SKILL_LABELS[attr].split(" ").first(2).join(" ") %>
                    </p>
                  </div>
                <% end %>
              </div>
              <% if enrollment.review.comment.present? %>
                <p class="text-sm text-slate-600 italic">"<%= enrollment.review.comment %>"</p>
              <% end %>

            <% else %>
              <%# Pendiente — formulario de calificación %>
              <%= form_with url: event_reviews_path(event), method: :post do %>

                <div class="space-y-3 mb-5">
                  <% EnrollmentReview::SKILL_ATTRS.each do |attr| %>
                    <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
                      <p class="text-xs font-bold text-slate-700 mb-3 uppercase tracking-wide">
                        <%= EnrollmentReview::SKILL_LABELS[attr] %>
                      </p>
                      <div class="grid grid-cols-5 gap-2">
                        <% [
                          [0, "#e2e8f0", "#475569"],
                          [1, "#dbeafe", "#1d4ed8"],
                          [2, "#fef9c3", "#854d0e"],
                          [3, "#ffedd5", "#9a3412"],
                          [4, "#dcfce7", "#166534"]
                        ].each do |val, bg, fg| %>
                          <label class="cursor-pointer">
                            <input type="radio"
                              name="reviews[<%= enrollment.id %>][<%= attr %>]"
                              value="<%= val %>"
                              <%= val == 0 ? "checked" : "" %>
                              class="sr-only peer">
                            <div class="rounded-xl border-2 border-transparent text-center py-3 transition-all cursor-pointer
                                        peer-checked:border-wine-600"
                                 style="background:<%= bg %>; color:<%= fg %>;">
                              <p class="text-xl font-extrabold leading-none"><%= val %></p>
                            </div>
                          </label>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>

                <div class="mb-4">
                  <label class="block text-xs font-bold text-slate-600 uppercase tracking-wide mb-2">
                    Comentario <span class="font-normal text-slate-400 normal-case">(opcional)</span>
                  </label>
                  <textarea name="reviews[<%= enrollment.id %>][comment]"
                    rows="2" maxlength="500"
                    placeholder="Observaciones sobre el desempeño del voluntario..."
                    class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 transition resize-none"></textarea>
                </div>

                <div class="flex justify-end">
                  <button type="submit"
                    class="rounded-xl px-6 py-2.5 text-sm font-semibold cursor-pointer shadow-sm"
                    style="background:#7f1d1d; color:white;">
                    Guardar calificación
                  </button>
                </div>

              <% end %>
            <% end %>
          </div>

        </details>
      <% end %>
    </div>
  <% end %>

<%# ── Voluntario: su estado y calificaciones recibidas ── %>
<% else %>

  <% enrollment = event.enrollments.find_by(user: current_user) %>

  <div class="max-w-2xl mx-auto space-y-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-slate-800 mb-4">Tu participación</h2>
      <%= render "events/enrollment_section", event: event, enrollment: enrollment %>
    </div>

    <% if enrollment&.asistio? && enrollment.review.present? %>
      <div class="rounded-2xl border border-green-200 bg-green-50 p-5 shadow-sm">
        <p class="font-semibold text-green-900 mb-3">⭐ Calificación recibida</p>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <% EnrollmentReview::SKILL_ATTRS.each do |attr| %>
            <% val = enrollment.review.send(attr) %>
            <div class="flex items-center justify-between rounded-lg bg-white border border-green-100 px-3 py-2">
              <span class="text-xs text-slate-600"><%= EnrollmentReview::SKILL_LABELS[attr].split(" ").first(2).join(" ") %></span>
              <span class="text-sm font-bold
                <%= val >= 3 ? 'text-green-700' : val >= 2 ? 'text-yellow-600' : 'text-slate-500' %>">
                <%= val %>/4
              </span>
            </div>
          <% end %>
        </div>
        <% if enrollment.review.comment.present? %>
          <p class="text-sm text-slate-600 italic">"<%= enrollment.review.comment %>"</p>
          <p class="text-xs text-slate-400 mt-1">— <%= enrollment.review.reviewer.name %></p>
        <% end %>
      </div>
    <% elsif enrollment&.asistio? %>
      <div class="rounded-2xl border border-dashed border-amber-300 bg-amber-50 p-5 text-center">
        <p class="text-sm text-amber-700">Participaste en este evento. La organización aún no ingresó tu calificación.</p>
      </div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to "← Volver a eventos", events_path, class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
  </div>

<% end %>
