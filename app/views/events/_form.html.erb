<%= form_with(model: event, class: "space-y-5") do |form| %>
  <% if event.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold mb-1"><%= pluralize(event.errors.count, "error") %> al guardar:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_field :title, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :description, "Descripción", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.textarea :description, rows: 4, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :date, "Fecha y hora", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.datetime_field :date, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :location, "Ubicación", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_field :location, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :organization_id, "Organización", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.collection_select :organization_id, Organization.all, :id, :name,
          { prompt: "Seleccioná una organización" },
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :status, "Estado", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.select :status, Event.statuses.keys.map { |s| [s.capitalize, s] },
          { prompt: "Seleccioná un estado" },
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.submit class: "rounded-lg bg-wine-800 px-5 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
