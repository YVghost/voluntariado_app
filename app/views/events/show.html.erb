<%= turbo_stream_from @event, :status %>

<%= render "events/event_header", event: @event %>

<%# Botón finalizar (solo admin/organizador) %>
<% if policy(@event).update? && @event.activo? %>
  <div class="mb-6">
    <%= button_to "Marcar como finalizado", finalizar_event_path(@event), method: :patch,
        data: { turbo_confirm: "¿Marcar este evento como finalizado?" },
        class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors cursor-pointer" %>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <%# Columna izquierda: inscripción %>
  <div class="lg:col-span-1">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-slate-800 mb-4">Tu inscripción</h2>
      <%= render "events/enrollment_section",
            event: @event,
            enrollment: @event.enrollments.find_by(user: current_user) %>
    </div>
  </div>

  <%# Columna derecha: chat %>
  <div class="lg:col-span-2">
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm flex flex-col">
      <div class="px-5 py-4 border-b border-slate-100">
        <h2 class="font-semibold text-slate-800">Chat del evento</h2>
      </div>

      <%= turbo_stream_from @event, :chat %>

      <div id="messages" class="flex flex-col gap-3 p-5 min-h-48 max-h-96 overflow-y-auto">
        <%= render @event.messages.order(:created_at) %>
      </div>

      <div class="px-5 py-4 border-t border-slate-100">
        <%= render "events/message_form", event: @event %>
      </div>
    </div>
  </div>

</div>

<%# Acciones de admin %>
<% if policy(@event).update? %>
  <div class="mt-8 flex items-center gap-4 pt-6 border-t border-slate-200">
    <%= link_to "Editar evento", edit_event_path(@event),
          class: "text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" %>
    <%= button_to "Eliminar evento", @event, method: :delete,
          data: { turbo_confirm: "¿Eliminar este evento permanentemente?" },
          class: "text-sm font-medium text-red-600 hover:text-red-800 transition-colors cursor-pointer bg-transparent border-none" %>
  </div>
<% end %>

<div class="mt-4">
  <%= link_to "← Volver a eventos", events_path,
        class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
</div>
