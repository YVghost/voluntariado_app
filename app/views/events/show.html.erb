<%= turbo_stream_from @event, :status %>

<%= render "events/event_header", event: @event %>

<% if @event.activo? %>
  <%= render "events/show_activo", event: @event %>

<% elsif @event.en_curso? %>
  <%= render "events/show_en_curso", event: @event %>

<% elsif @event.finalizado? %>
  <%= render "events/show_finalizado", event: @event %>

<% elsif @event.cancelado? %>
  <div class="rounded-2xl border border-red-200 bg-red-50 p-8 text-center mb-6">
    <p class="text-red-700 font-semibold mb-1">Este evento fue cancelado</p>
    <p class="text-sm text-red-500">No se inició dentro de los 3 días posteriores a la fecha programada.</p>
  </div>
  <%= link_to "← Volver a eventos", events_path,
        class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
<% end %>
