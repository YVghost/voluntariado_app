<div id="<%= dom_id event %>">
  <div>
    <strong>Title:</strong>
    <%= event.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= event.description %>
  </div>

  <div>
    <strong>Date:</strong>
    <%= event.date %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= event.status %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= event.location %>
  </div>

  <div>
    <strong>Organization:</strong>
    <%= event.organization_id %>
  </div>

</div>
