<div id="enrollment_section">
  <%# Organizadores y admins no se inscriben %>
  <% if current_user.organizador? || current_user.admin? %>
    <p class="text-sm text-slate-400 italic">
      Los organizadores y administradores gestionan inscripciones desde el panel del evento.
    </p>

  <%# Evento finalizado %>
  <% elsif event.finalizado? %>
    <% if enrollment&.asistio? %>
      <div class="rounded-lg bg-wine-50 border border-wine-200 px-4 py-3 text-sm space-y-1">
        <p class="font-semibold text-wine-800">✓ Participaste en este evento</p>
        <% if enrollment.attended_at.present? %>
          <p class="text-slate-500">Asistencia registrada: <%= enrollment.attended_at.strftime("%d/%m %H:%M") %></p>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-lg bg-slate-50 border border-slate-200 px-4 py-3 text-sm text-slate-500">
        Este evento ya finalizó.
      </div>
    <% end %>

  <%# Voluntario sin perfil completo — bloqueado %>
  <% elsif current_user.voluntario? && !current_user.profile_complete? %>
    <div class="rounded-lg bg-slate-50 border border-dashed border-slate-300 px-4 py-4 text-sm text-center space-y-3">
      <p class="text-slate-600 font-medium">Necesitás completar tu perfil para participar</p>
      <%= link_to "Completar perfil →", quiz_path,
            class: "inline-block rounded-lg bg-amber-600 px-4 py-2 text-xs font-semibold text-white hover:bg-amber-500 transition-colors" %>
    </div>

  <%# Si es emergencia, calcular el tier del voluntario %>
  <% elsif event.emergency_level.present? && current_user.voluntario? %>
    <% profile = current_user.volunteer_profile %>
    <% tier = profile&.tier_for_event(event) %>

    <%# Bloqueado: no tiene capacidad para esta emergencia %>
    <% if tier.nil? %>
      <div class="rounded-lg bg-slate-100 border border-slate-200 px-4 py-4 text-sm space-y-2">
        <p class="font-semibold text-slate-600">No capacitado para esta emergencia</p>
        <p class="text-xs text-slate-500">
          Tu perfil de habilidades no alcanza el nivel mínimo requerido para T<%= event.emergency_level %>.
          Podés mejorar tu score participando en eventos y recibiendo calificaciones.
        </p>
      </div>

    <%# Ya inscrito — mostrar estado %>
    <% elsif enrollment.present? && !enrollment.cancelado? %>

      <% if enrollment.second_wave? %>
        <%# Segunda ola (misión internacional) %>
        <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-4 text-sm space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-lg">🌐</span>
            <p class="font-semibold text-blue-800">Convocado como segunda ola</p>
          </div>
          <p class="text-xs text-blue-700">
            Este evento es en otro país. Tiempo estimado de llegada:
            <strong><%= enrollment.expected_arrival&.strftime("%d/%m/%Y") || "por confirmar" %></strong>
          </p>
          <% if enrollment.convocado? %>
            <%= button_to "Confirmar disponibilidad para viajar",
                  event_enrollment_path(event, enrollment),
                  method: :patch,
                  params: { enrollment: { status: "confirmado" } },
                  class: "w-full rounded-lg bg-blue-700 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-600 transition-colors cursor-pointer" %>
          <% elsif enrollment.confirmado? %>
            <div class="flex items-center gap-2 rounded-lg bg-blue-100 px-3 py-2 text-xs text-blue-800">
              <span>✓</span> Confirmaste tu viaje
            </div>
          <% end %>
        </div>

      <% elsif enrollment.convocado? %>
        <%# Convocado directo o con conflicto %>
        <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm space-y-3">
          <p class="font-semibold text-amber-800">🚨 Fuiste convocado para esta emergencia</p>
          <p class="text-amber-700 text-xs">Confirmá tu asistencia para que la organización sepa que vas a participar.</p>
          <%= button_to "Confirmar participación",
                event_enrollment_path(event, enrollment),
                method: :patch,
                params: { enrollment: { status: "confirmado" } },
                class: "w-full rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-500 transition-colors cursor-pointer" %>
        </div>

      <% elsif enrollment.confirmado? %>
        <div class="mb-4 flex items-center gap-2 rounded-lg bg-green-50 border border-green-200 px-3 py-2 text-sm text-green-700">
          <span>✓</span> Estás confirmado en este evento
        </div>
        <%= button_to "Cancelar inscripción", event_enrollment_path(event, enrollment), method: :delete,
              data: { turbo_confirm: "¿Seguro que querés cancelar?" },
              class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-500 hover:bg-slate-50 transition-colors cursor-pointer" %>

      <% elsif enrollment.asistio? %>
        <div class="rounded-lg bg-wine-50 border border-wine-200 px-4 py-3 text-sm space-y-1">
          <p class="font-semibold text-wine-800">✓ Asistencia registrada</p>
          <% if enrollment.attended_at.present? %>
            <p class="text-slate-500">Hora: <%= enrollment.attended_at.strftime("%H:%M") %></p>
          <% end %>
        </div>
      <% end %>

    <%# No inscrito — opciones según tier %>
    <% else %>
      <% if tier == :immediate %>
        <%# Capacitado pero aún no convocado (ej: se inscribe manualmente antes del matching) %>
        <div class="mb-3 rounded-lg bg-green-50 border border-green-200 px-3 py-2 text-xs text-green-800">
          <span class="font-semibold">✓ Capacitado</span> — Tu perfil cumple los requisitos para participar directamente.
        </div>
        <%= button_to "Inscribirme", event_enrollments_path(event), method: :post,
              class: "w-full rounded-lg bg-wine-800 px-4 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>

      <% elsif tier == :support %>
        <%# Apoyo — puede ver y sumarse %>
        <div class="mb-3 rounded-lg bg-slate-50 border border-slate-200 px-3 py-3 text-xs text-slate-700 space-y-1">
          <p class="font-semibold text-slate-800">Podés sumarte como apoyo</p>
          <p class="text-slate-500">Tu nivel de habilidades te permite colaborar como voluntario de apoyo en esta emergencia.</p>
        </div>
        <%= button_to "Ofrecerme como apoyo", event_enrollments_path(event), method: :post,
              class: "w-full rounded-lg border-2 border-wine-300 bg-white px-4 py-2 text-sm font-semibold text-wine-800 hover:bg-wine-50 transition-colors cursor-pointer" %>
      <% end %>

      <%# Si canceló, puede volver a inscribirse si tiene tier %>
      <% if enrollment&.cancelado? %>
        <p class="text-xs text-slate-400 mt-2">Cancelaste tu inscripción.</p>
      <% end %>
    <% end %>

  <%# Evento normal (sin emergency_level) — inscripción libre %>
  <% elsif enrollment.nil? || enrollment.cancelado? %>
    <%= button_to "Inscribirme", event_enrollments_path(event), method: :post,
          class: "w-full rounded-lg bg-wine-800 px-4 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
    <% if enrollment&.cancelado? %>
      <p class="text-xs text-slate-400 mt-2">Cancelaste tu inscripción anterior.</p>
    <% end %>

  <% elsif enrollment.confirmado? %>
    <div class="mb-4 flex items-center gap-2 rounded-lg bg-green-50 border border-green-200 px-3 py-2 text-sm text-green-700">
      <span>✓</span> Estás confirmado
    </div>
    <%= button_to "Cancelar inscripción", event_enrollment_path(event, enrollment), method: :delete,
          data: { turbo_confirm: "¿Seguro que querés cancelar?" },
          class: "w-full rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-500 hover:bg-slate-50 transition-colors cursor-pointer" %>

  <% elsif enrollment.asistio? %>
    <div class="rounded-lg bg-wine-50 border border-wine-200 px-4 py-3 text-sm">
      <p class="font-semibold text-wine-800">✓ Asistencia registrada</p>
    </div>
  <% end %>
</div>
