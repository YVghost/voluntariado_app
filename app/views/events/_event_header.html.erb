<div id="event_header" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 mb-1"><%= event.title %></h1>
      <p class="text-sm text-slate-500"><%= event.organization.name %></p>
    </div>
    <span class="shrink-0 rounded-full px-3 py-1 text-sm font-semibold
      <%= event.finalizado? ? 'bg-slate-100 text-slate-500' : 'bg-green-100 text-green-700' %>">
      <%= event.finalizado? ? "Finalizado" : "Activo" %>
    </span>
  </div>

  <p class="mt-4 text-slate-700 leading-relaxed"><%= event.description %></p>

  <div class="mt-4 grid grid-cols-2 gap-3 text-sm text-slate-600">
    <div class="flex items-center gap-2">
      <span class="text-slate-400">📅</span>
      <%= event.date&.strftime("%d de %B, %Y — %H:%M hs") %>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-slate-400">📍</span>
      <%= event.location %>
    </div>
  </div>
</div>
