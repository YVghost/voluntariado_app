<%# organization, rep, and f (form builder) must be set by caller %>
<div class="space-y-6">

  <% if organization.errors.any? || rep.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold mb-1">Por favor corrige los siguientes errores:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% (organization.errors.full_messages + rep.errors.full_messages).each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Datos de la organización %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-sm font-semibold text-slate-700 mb-4">Datos de la organización</h3>
    <div class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Nombre", class: "block text-xs font-medium text-slate-600 mb-1" %>
          <%= f.text_field :name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
        </div>
        <div>
          <%= f.label :ruc, "RUC", class: "block text-xs font-medium text-slate-600 mb-1" %>
          <%= f.text_field :ruc, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-wine-300" %>
        </div>
      </div>
      <div>
        <%= f.label :location, "Ubicación", class: "block text-xs font-medium text-slate-600 mb-1" %>
        <%= f.text_field :location, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
      </div>
      <div>
        <%= f.label :description, "Descripción", class: "block text-xs font-medium text-slate-600 mb-1" %>
        <%= f.text_area :description, rows: 3, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300 resize-none" %>
      </div>
    </div>
  </div>

  <%# Datos del representante %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-sm font-semibold text-slate-700 mb-4">Representante / Organizador</h3>
    <div class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Nombres</label>
          <%= text_field_tag "representante[nombres]", rep.nombres,
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Apellidos</label>
          <%= text_field_tag "representante[apellidos]", rep.apellidos,
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Cédula</label>
          <%= text_field_tag "representante[cedula]", rep.cedula,
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-wine-300" %>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Email</label>
          <%= email_field_tag "representante[email]", rep.email,
                class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
        </div>
      </div>
      <div class="border-t border-slate-100 pt-4">
        <p class="text-xs font-medium text-slate-500 mb-3">
          Contraseña <%= organization.persisted? ? "(dejar en blanco para no cambiar)" : "" %>
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Contraseña</label>
            <%= password_field_tag "representante[password]", nil, autocomplete: "new-password",
                  class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Confirmar contraseña</label>
            <%= password_field_tag "representante[password_confirmation]", nil, autocomplete: "new-password",
                  class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to "Cancelar", admin_dashboard_index_path(tab: "organizaciones"),
          class: "rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50 transition-colors" %>
    <%= f.submit (organization.persisted? ? "Guardar cambios" : "Crear organización"),
          class: "rounded-lg bg-wine-800 px-4 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
  </div>

</div>
