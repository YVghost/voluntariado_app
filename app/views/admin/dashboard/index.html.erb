<div class="mb-8">
  <h1 class="text-2xl font-bold text-slate-900">Panel de Administración</h1>
  <p class="text-sm text-slate-500 mt-1">Gestión completa del sistema</p>
</div>

<%# Estadísticas rápidas %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="rounded-xl bg-white border border-slate-200 p-4 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Usuarios</p>
    <p class="text-3xl font-bold text-slate-900 mt-1"><%= @users.count %></p>
  </div>
  <div class="rounded-xl bg-white border border-slate-200 p-4 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Organizaciones</p>
    <p class="text-3xl font-bold text-slate-900 mt-1"><%= @organizations.count %></p>
  </div>
  <div class="rounded-xl bg-white border border-slate-200 p-4 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Eventos</p>
    <p class="text-3xl font-bold text-slate-900 mt-1"><%= @events.count %></p>
  </div>
  <div class="rounded-xl bg-white border border-slate-200 p-4 shadow-sm">
    <p class="text-xs font-medium text-slate-500 uppercase tracking-wide">Inscripciones</p>
    <p class="text-3xl font-bold text-slate-900 mt-1"><%= @enrollments.count %></p>
  </div>
</div>

<%# Tabs %>
<div data-controller="tabs" data-tabs-default-value="usuarios">

  <div class="flex gap-1 border-b border-slate-200 mb-6">
    <% [["usuarios","Usuarios"], ["organizaciones","Organizaciones"], ["eventos","Eventos"], ["inscripciones","Inscripciones"]].each do |tab, label| %>
      <button type="button"
        data-tabs-target="tab"
        data-tab="<%= tab %>"
        data-action="click->tabs#select"
        class="px-5 py-3 text-sm border-b-2 transition-colors border-transparent text-slate-500">
        <%= label %>
      </button>
    <% end %>
  </div>

  <%# ── USUARIOS ── %>
  <div data-tabs-target="panel" data-tab="usuarios">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-slate-800">Usuarios (<%= @users.count %>)</h2>
      <%= link_to "＋ Nuevo usuario", new_admin_user_path,
            class: "rounded-lg bg-wine-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-wine-700 transition-colors" %>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Nombre</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Email</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Cédula</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Rol</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Registro</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @users.each do |user| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-medium text-slate-800"><%= user.name.presence || "—" %></td>
              <td class="px-4 py-3 text-slate-600"><%= user.email %></td>
              <td class="px-4 py-3 text-slate-500 font-mono text-xs"><%= user.cedula.presence || "—" %></td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                  <%= user.admin? ? 'bg-wine-100 text-wine-800' :
                      user.organizador? ? 'bg-blue-100 text-blue-700' :
                                         'bg-green-100 text-green-700' %>">
                  <%= user.role %>
                </span>
              </td>
              <td class="px-4 py-3 text-slate-400 text-xs"><%= user.created_at.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3 justify-end">
                  <%# Cambiar rol %>
                  <%= form_with url: update_user_role_admin_dashboard_index_path, method: :patch, class: "flex items-center gap-1" do |f| %>
                    <%= f.hidden_field :id, value: user.id %>
                    <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] },
                          { selected: user.role },
                          class: "rounded border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-1 focus:ring-wine-300" %>
                    <%= f.submit "✓", class: "rounded bg-slate-100 px-2 py-1 text-xs text-slate-600 hover:bg-slate-200 cursor-pointer" %>
                  <% end %>
                  <%= link_to "Editar", edit_admin_user_path(user),
                        class: "text-xs text-slate-500 hover:text-slate-800 transition-colors" %>
                  <% unless user == current_user %>
                    <%= button_to "✕", destroy_user_admin_dashboard_index_path(id: user.id),
                          method: :delete,
                          data: { turbo_confirm: "¿Eliminar a #{user.email}?" },
                          class: "text-xs text-red-400 hover:text-red-600 transition-colors cursor-pointer bg-transparent border-none" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── ORGANIZACIONES ── %>
  <div data-tabs-target="panel" data-tab="organizaciones" class="hidden">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-slate-800">Organizaciones (<%= @organizations.count %>)</h2>
      <%= link_to "＋ Nueva organización", new_admin_organization_path,
            class: "rounded-lg bg-wine-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-wine-700 transition-colors" %>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Nombre</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">RUC</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Ubicación</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Representante</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Eventos</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @organizations.each do |org| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-medium text-slate-800">
                <%= link_to org.name, org, class: "hover:text-wine-800 transition-colors" %>
              </td>
              <td class="px-4 py-3 text-slate-500 font-mono text-xs"><%= org.ruc.presence || "—" %></td>
              <td class="px-4 py-3 text-slate-600"><%= org.location %></td>
              <td class="px-4 py-3 text-slate-600"><%= org.user&.name || "—" %></td>
              <td class="px-4 py-3 text-slate-500"><%= org.events.count %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3 justify-end">
                  <%= link_to "Editar", edit_admin_organization_path(org),
                        class: "text-xs text-slate-500 hover:text-slate-800 transition-colors" %>
                  <%= button_to "✕", destroy_organization_admin_dashboard_index_path(id: org.id),
                        method: :delete,
                        data: { turbo_confirm: "¿Eliminar #{org.name}?" },
                        class: "text-xs text-red-400 hover:text-red-600 transition-colors cursor-pointer bg-transparent border-none" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── EVENTOS ── %>
  <div data-tabs-target="panel" data-tab="eventos" class="hidden">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-slate-800">Eventos (<%= @events.count %>)</h2>
      <%= link_to "＋ Nuevo evento", new_event_path,
            class: "rounded-lg bg-wine-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-wine-700 transition-colors" %>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Título</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Organización</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Fecha</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Estado</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Inscritos</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @events.each do |event| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-medium text-slate-800">
                <%= link_to event.title, event, class: "hover:text-wine-800 transition-colors" %>
              </td>
              <td class="px-4 py-3 text-slate-600"><%= event.organization.name %></td>
              <td class="px-4 py-3 text-slate-500 text-xs"><%= event.date&.strftime("%d/%m/%Y %H:%M") %></td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                  <%= event.activo? ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500' %>">
                  <%= event.activo? ? "Activo" : "Finalizado" %>
                </span>
              </td>
              <td class="px-4 py-3 text-slate-500"><%= event.enrollments.where.not(status: :cancelado).count %></td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3 justify-end">
                  <%= link_to "Editar", edit_event_path(event),
                        class: "text-xs text-slate-500 hover:text-slate-800 transition-colors" %>
                  <%= button_to "✕", destroy_event_admin_dashboard_index_path(id: event.id),
                        method: :delete,
                        data: { turbo_confirm: "¿Eliminar #{event.title}?" },
                        class: "text-xs text-red-400 hover:text-red-600 transition-colors cursor-pointer bg-transparent border-none" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%# ── INSCRIPCIONES ── %>
  <div data-tabs-target="panel" data-tab="inscripciones" class="hidden">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-slate-800">Inscripciones (<%= @enrollments.count %>)</h2>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Voluntario</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Evento</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Estado</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Check-in</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Ubicación</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @enrollments.each do |enrollment| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-medium text-slate-800"><%= enrollment.user.name %></td>
              <td class="px-4 py-3 text-slate-600">
                <%= link_to enrollment.event.title, enrollment.event,
                      class: "hover:text-wine-800 transition-colors" %>
              </td>
              <td class="px-4 py-3">
                <span class="rounded-full px-2 py-0.5 text-xs font-medium
                  <%= enrollment.inscrito?  ? 'bg-blue-100 text-blue-700'   :
                      enrollment.asistio?   ? 'bg-green-100 text-green-700' :
                                             'bg-slate-100 text-slate-400' %>">
                  <%= enrollment.status %>
                </span>
              </td>
              <td class="px-4 py-3 text-slate-500 text-xs">
                <%= enrollment.check_in_time&.strftime("%d/%m %H:%M") || "—" %>
              </td>
              <td class="px-4 py-3 text-slate-400 text-xs font-mono">
                <% if enrollment.latitude.present? %>
                  <%= enrollment.latitude.round(4) %>, <%= enrollment.longitude.round(4) %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="px-4 py-3">
                <%= button_to "✕", destroy_enrollment_admin_dashboard_index_path(id: enrollment.id),
                      method: :delete,
                      data: { turbo_confirm: "¿Eliminar esta inscripción?" },
                      class: "text-xs text-red-400 hover:text-red-600 transition-colors cursor-pointer bg-transparent border-none" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div><%# end tabs %>
