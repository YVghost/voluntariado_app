<%# Shared form for admin user new/edit %>
<div class="space-y-5">

  <% if user.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold mb-1">Por favor corrige los siguientes errores:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :nombres, "Nombres", class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.text_field :nombres, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
    </div>
    <div>
      <%= f.label :apellidos, "Apellidos", class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.text_field :apellidos, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :cedula, "Cédula", class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.text_field :cedula, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-wine-300" %>
    </div>
    <div>
      <%= f.label :email, "Email", class: "block text-xs font-medium text-slate-600 mb-1" %>
      <%= f.email_field :email, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
    </div>
  </div>

  <div>
    <%= f.label :role, "Rol", class: "block text-xs font-medium text-slate-600 mb-1" %>
    <%= f.select :role, User.roles.keys.map { |r| [r.capitalize, r] },
          { selected: user.role },
          class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
  </div>

  <div class="border-t border-slate-100 pt-4">
    <p class="text-xs font-medium text-slate-500 mb-3">
      Contraseña <%= user.persisted? ? "(dejar en blanco para no cambiar)" : "" %>
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :password, "Nueva contraseña", class: "block text-xs font-medium text-slate-600 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
      </div>
      <div>
        <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-xs font-medium text-slate-600 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Cancelar", admin_dashboard_index_path(tab: "usuarios"),
          class: "rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50 transition-colors" %>
    <%= f.submit (user.persisted? ? "Guardar cambios" : "Crear usuario"),
          class: "rounded-lg bg-wine-800 px-4 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
  </div>

</div>
