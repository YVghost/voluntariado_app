<div class="min-h-[60vh] flex items-center justify-center">
  <div class="w-full max-w-sm">

    <div class="text-center mb-8">
      <span class="text-wine-800 text-3xl font-bold tracking-tight">♦ Voluntariado</span>
      <p class="text-slate-500 text-sm mt-2">Iniciá sesión para continuar</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-5") do |f| %>

        <div>
          <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
        </div>

        <div>
          <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-slate-700 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password",
                class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-slate-300 text-wine-700 focus:ring-wine-400" %>
            <%= f.label :remember_me, "Recordarme", class: "text-sm text-slate-600" %>
          </div>
        <% end %>

        <%= f.submit "Iniciar sesión",
              class: "w-full rounded-lg bg-wine-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
      <% end %>
    </div>

    <div class="mt-5 text-center space-y-2 text-sm text-slate-500">
      <%= link_to "¿No tenés cuenta? Registrarte", new_user_registration_path, class: "hover:text-wine-800 transition-colors" %>
      <br>
      <%= link_to "¿Olvidaste tu contraseña?", new_user_password_path, class: "hover:text-wine-800 transition-colors" %>
    </div>

  </div>
</div>
