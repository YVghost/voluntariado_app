<div class="min-h-[70vh] flex items-center justify-center py-8">
  <div class="w-full max-w-lg">

    <div class="text-center mb-8">
      <span class="text-wine-800 text-3xl font-bold tracking-tight">♦ Voluntariado</span>
      <p class="text-slate-500 text-sm mt-2">Creá tu cuenta</p>
    </div>

    <div data-controller="registration-tabs">

      <%# Tabs %>
      <div class="flex border-b border-slate-200 mb-6">
        <button type="button"
          data-registration-tabs-target="tab"
          data-type="voluntario"
          data-action="click->registration-tabs#select"
          class="flex-1 py-3 text-sm border-b-2 transition-colors border-transparent text-slate-500">
          Voluntario
        </button>
        <button type="button"
          data-registration-tabs-target="tab"
          data-type="organizacion"
          data-action="click->registration-tabs#select"
          class="flex-1 py-3 text-sm border-b-2 transition-colors border-transparent text-slate-500">
          Organización
        </button>
      </div>

      <%# Errores generales %>
      <% if resource.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 mb-6">
          <p class="font-semibold mb-1">
            <%= pluralize(resource.errors.count, "error") %> al guardar:
          </p>
          <ul class="list-disc list-inside space-y-0.5">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Campo oculto para tipo de registro %>
      <input type="hidden" name="registration_type" value="voluntario"
             data-registration-tabs-target="typeInput">

      <%# ── PANEL VOLUNTARIO ── %>
      <div data-registration-tabs-target="panel" data-type="voluntario">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "space-y-4") do |f| %>
          <input type="hidden" name="registration_type" value="voluntario">

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :nombres, "Nombres completos", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= f.text_field :nombres, autocomplete: "given-name",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>
            <div>
              <%= f.label :apellidos, "Apellidos completos", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= f.text_field :apellidos, autocomplete: "family-name",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>
          </div>

          <div>
            <%= f.label :cedula, "Número de cédula", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.text_field :cedula, maxlength: 10, placeholder: "0000000000",
                  class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            <p class="text-xs text-slate-400 mt-1">10 dígitos — validación Registro Civil Ecuador</p>
          </div>

          <div>
            <%= f.label :email, "Correo electrónico", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.email_field :email, autocomplete: "email",
                  class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
          </div>

          <div>
            <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <% if @minimum_password_length %>
              <p class="text-xs text-slate-400 mb-1">Mínimo <%= @minimum_password_length %> caracteres</p>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password",
                  class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-medium text-slate-700 mb-1" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                  class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
          </div>

          <%= f.submit "Crear cuenta de voluntario",
                class: "w-full rounded-lg bg-wine-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
        <% end %>
      </div>

      <%# ── PANEL ORGANIZACIÓN ── %>
      <div data-registration-tabs-target="panel" data-type="organizacion" class="hidden">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "space-y-4") do |f| %>
          <input type="hidden" name="registration_type" value="organizacion">

          <%# Datos de la organización %>
          <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 space-y-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Datos de la organización</p>

            <div>
              <%= label_tag "organization_name", "Nombre de la organización", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= text_field_tag "organization[name]", nil,
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>

            <div>
              <%= label_tag "organization_ruc", "RUC", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= text_field_tag "organization[ruc]", nil, maxlength: 13, placeholder: "1725958449001",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
              <p class="text-xs text-slate-400 mt-1">
                13 dígitos — Persona natural: cédula + 001 (ej. 1725958449<strong>001</strong>).
                Sociedad/empresa: tercer dígito 9, termina en 001.
              </p>
            </div>

            <div>
              <%= label_tag "organization_description", "Descripción", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= text_area_tag "organization[description]", nil, rows: 3,
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>

            <div>
              <%= label_tag "organization_location", "Ubicación / Ciudad", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= text_field_tag "organization[location]", nil,
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>
          </div>

          <%# Datos del representante %>
          <div class="rounded-lg bg-slate-50 border border-slate-200 p-4 space-y-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Datos del representante legal</p>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <%= f.label :nombres, "Nombres", class: "block text-sm font-medium text-slate-700 mb-1" %>
                <%= f.text_field :nombres,
                      class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
              </div>
              <div>
                <%= f.label :apellidos, "Apellidos", class: "block text-sm font-medium text-slate-700 mb-1" %>
                <%= f.text_field :apellidos,
                      class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
              </div>
            </div>

            <div>
              <%= f.label :cedula, "Cédula del representante", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= f.text_field :cedula, maxlength: 10, placeholder: "0000000000",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>

            <div>
              <%= f.label :email, "Correo electrónico (acceso al sistema)", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= f.email_field :email, autocomplete: "email",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>

            <div>
              <%= f.label :password, "Contraseña", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= f.password_field :password, autocomplete: "new-password",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirmar contraseña", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password",
                    class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
            </div>
          </div>

          <%= f.submit "Registrar organización",
                class: "w-full rounded-lg bg-wine-800 px-4 py-2.5 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
        <% end %>
      </div>

    </div><%# end data-controller %>

    <div class="mt-5 text-center text-sm text-slate-500">
      <%= link_to "¿Ya tenés cuenta? Iniciá sesión", new_user_session_path,
            class: "hover:text-wine-800 transition-colors" %>
    </div>

  </div>
</div>
