<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">Mi perfil</h1>

  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-6">
    <h2 class="font-semibold text-slate-800 mb-4">Datos de cuenta</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300 transition" %>
      </div>

      <div>
        <%= f.label :password, "Nueva contraseña", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300 transition" %>
        <p class="text-xs text-slate-400 mt-1">Dejar en blanco para no cambiar</p>
      </div>

      <div>
        <%= f.label :current_password, "Contraseña actual", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :current_password, autocomplete: "current-password",
              class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wine-300 transition" %>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Guardar cambios", class: "rounded-lg bg-wine-800 px-4 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if current_user.voluntario? %>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-6">
      <div class="flex items-start justify-between mb-4">
        <h2 class="font-semibold text-slate-800">Perfil de habilidades</h2>
        <%= link_to "Actualizar perfil", quiz_path,
              class: "rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors" %>
      </div>

      <% if (profile = current_user.volunteer_profile) && profile.quiz_completed_at.present? %>
        <%# Score visual %>
        <div class="mb-4">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-slate-500">Puntuación global</span>
            <span class="text-lg font-bold
              <%= profile.score >= 7 ? 'text-green-700' : profile.score >= 5 ? 'text-yellow-600' : 'text-red-600' %>">
              <%= profile.score %>/10
            </span>
          </div>
          <div class="h-2 w-full rounded-full bg-slate-100">
            <div class="h-2 rounded-full transition-all
              <%= profile.score >= 7 ? 'bg-green-500' : profile.score >= 5 ? 'bg-yellow-400' : 'bg-red-400' %>"
              style="width: <%= (profile.score / 10.0 * 100).round %>%"></div>
          </div>
        </div>

        <%# Skills activas %>
        <% if profile.skills.any? %>
          <div class="mb-4">
            <p class="text-xs font-medium text-slate-500 mb-2">Habilidades activas</p>
            <div class="flex flex-wrap gap-2">
              <% profile.skills.each do |s| %>
                <span class="rounded-full bg-wine-100 px-3 py-1 text-xs font-medium text-wine-800">
                  <%= VolunteerProfile::SKILL_LABELS[s] || s %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Dirección %>
        <% if profile.city.present? %>
          <p class="text-xs text-slate-500">
            📍 <%= [profile.sector, profile.city, profile.country].compact.reject(&:empty?).join(", ") %>
          </p>
        <% end %>

        <%# Disponibilidad toggle %>
        <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-slate-700">Disponibilidad para emergencias</p>
            <p class="text-xs text-slate-400">
              <%= profile.available? ? "Podés ser convocado automáticamente" : "No recibís convocatorias automáticas" %>
            </p>
          </div>
          <%= button_to profile.available? ? "Pausar" : "Activar",
                toggle_availability_quiz_path,
                method: :patch,
                class: "rounded-lg px-4 py-2 text-sm font-medium transition-colors cursor-pointer
                  #{profile.available? ? 'bg-slate-100 text-slate-600 hover:bg-slate-200' : 'bg-green-100 text-green-700 hover:bg-green-200'}" %>
        </div>
      <% else %>
        <div class="rounded-lg border border-dashed border-amber-300 bg-amber-50 p-4 text-center">
          <p class="text-sm text-amber-700 mb-3">Aún no completaste tu perfil de habilidades.</p>
          <%= link_to "Completar ahora →", quiz_path,
                class: "rounded-lg bg-amber-600 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-500 transition-colors" %>
        </div>
      <% end %>
    </div>

    <div class="text-center">
      <%= button_to "Cancelar mi cuenta", registration_path(resource_name),
            data: { turbo_confirm: "¿Estás seguro? Esta acción es irreversible." },
            method: :delete,
            class: "text-xs text-red-400 hover:text-red-600 transition-colors cursor-pointer bg-transparent border-none" %>
    </div>
  <% end %>
</div>
