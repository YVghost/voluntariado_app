<div id="<%= dom_id notification %>"
     class="flex items-start justify-between gap-4 rounded-xl border bg-white p-4 shadow-sm
            <%= notification.read ? 'border-slate-200' : 'border-wine-200 bg-wine-50' %>">
  <div class="flex items-start gap-3">
    <% unless notification.read %>
      <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-wine-600"></span>
    <% else %>
      <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-slate-200"></span>
    <% end %>
    <div>
      <p class="text-sm text-slate-800 <%= 'font-semibold' unless notification.read %>">
        <%= notification.message %>
      </p>
      <p class="text-xs text-slate-400 mt-0.5">
        <%= notification.created_at.strftime("%d/%m/%Y a las %H:%M") %>
      </p>
    </div>
  </div>

  <% unless notification.read %>
    <%= button_to "✓", mark_as_read_notification_path(notification), method: :patch,
          class: "shrink-0 rounded-full border border-slate-200 bg-white w-7 h-7 text-xs text-slate-500 hover:bg-slate-50 transition-colors cursor-pointer" %>
  <% end %>
</div>
