<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Notificaciones</h1>
  <% if @notifications.any? { |n| !n.read } %>
    <%= button_to "Marcar todas como leídas", mark_all_as_read_notifications_path, method: :patch,
          class: "rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors cursor-pointer" %>
  <% end %>
</div>

<% if @notifications.any? %>
  <div id="notifications_list" class="space-y-3">
    <%= render @notifications %>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
    <p class="text-slate-400 text-sm">No tenés notificaciones.</p>
  </div>
<% end %>
