<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-slate-900">Organizaciones</h1>
  <% if policy(Organization).create? %>
    <%= link_to "＋ Nueva organización", new_organization_path,
          class: "rounded-lg bg-wine-800 px-4 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors" %>
  <% end %>
</div>

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% @organizations.each do |org| %>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md transition-shadow">
      <h2 class="font-semibold text-slate-900 mb-1"><%= org.name %></h2>
      <p class="text-xs text-slate-400 mb-2">📍 <%= org.location %></p>
      <p class="text-sm text-slate-500 line-clamp-3 mb-4"><%= org.description %></p>
      <div class="pt-3 border-t border-slate-100">
        <%= link_to "Ver organización →", org,
              class: "text-sm font-medium text-wine-800 hover:text-wine-600 transition-colors" %>
      </div>
    </div>
  <% end %>
</div>

<% if @organizations.empty? %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
    <p class="text-slate-400 text-sm">No hay organizaciones registradas aún.</p>
  </div>
<% end %>
