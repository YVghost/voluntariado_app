<%= form_with(model: organization, class: "space-y-5") do |form| %>
  <% if organization.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold mb-1"><%= pluralize(organization.errors.count, "error") %> al guardar:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% organization.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Nombre de la organización", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_field :name, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :ruc, "RUC", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.text_field :ruc, maxlength: 13, placeholder: "1725958449001",
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
    <p class="text-xs text-slate-400 mt-1">13 dígitos — validación SRI Ecuador</p>
  </div>

  <div>
    <%= form.label :description, "Descripción", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.textarea :description, rows: 4, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-wine-300 focus:border-wine-400 transition" %>
  </div>

  <div>
    <p class="block text-sm font-medium text-slate-700 mb-2">Ubicación</p>
    <%= render "shared/location_select",
          location_value: organization.location,
          input_name: "organization[location]",
          field_id: "org" %>
  </div>

  <div>
    <%= form.submit class: "rounded-lg bg-wine-800 px-5 py-2 text-sm font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
