<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm mb-6">
  <h1 class="text-2xl font-bold text-slate-900 mb-1"><%= @organization.name %></h1>
  <p class="text-sm text-slate-400 mb-4">📍 <%= @organization.location %></p>
  <p class="text-slate-700 leading-relaxed"><%= @organization.description %></p>
</div>

<% if @organization.events.any? %>
  <h2 class="text-lg font-semibold text-slate-800 mb-4">Eventos de esta organización</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    <% @organization.events.each do |event| %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="font-semibold text-slate-800 mb-1"><%= event.title %></p>
        <p class="text-xs text-slate-400 mb-3">📅 <%= event.date&.strftime("%d/%m/%Y") %></p>
        <%= link_to "Ver evento →", event, class: "text-sm text-wine-800 hover:text-wine-600 font-medium transition-colors" %>
      </div>
    <% end %>
  </div>
<% end %>

<% if policy(@organization).update? %>
  <div class="mt-8 flex items-center gap-4 pt-6 border-t border-slate-200">
    <%= link_to "Editar", edit_organization_path(@organization),
          class: "text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors" %>
    <%= button_to "Eliminar", @organization, method: :delete,
          data: { turbo_confirm: "¿Eliminar esta organización?" },
          class: "text-sm font-medium text-red-600 hover:text-red-800 transition-colors cursor-pointer bg-transparent border-none" %>
  </div>
<% end %>

<div class="mt-4">
  <%= link_to "← Volver", organizations_path,
        class: "text-sm text-slate-500 hover:text-slate-700 transition-colors" %>
</div>
