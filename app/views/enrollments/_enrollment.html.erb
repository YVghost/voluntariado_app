<div id="enrollment_<%= enrollment.id %>" class="flex items-center justify-between py-3.5 gap-4">
  <div class="flex items-center gap-3 min-w-0">
    <div class="h-9 w-9 rounded-full bg-wine-100 flex items-center justify-center text-sm font-bold text-wine-800 shrink-0">
      <%= enrollment.user.name&.first&.upcase || "?" %>
    </div>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-slate-800 truncate"><%= enrollment.user.name %></p>
      <% if (profile = enrollment.user.volunteer_profile) %>
        <div class="flex items-center gap-1.5 mt-1 flex-wrap">
          <% if profile.city.present? %>
            <span class="text-xs text-slate-400 flex items-center gap-1">
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              <%= profile.city %>
            </span>
          <% end %>
          <% profile.skills.first(2).each do |s| %>
            <span class="rounded-md bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600"><%= VolunteerProfile::SKILL_LABELS[s]&.split(" ")&.first || s %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2 shrink-0">
    <% if (profile = enrollment.user.volunteer_profile) %>
      <span class="rounded-lg px-2 py-1 text-xs font-bold tabular-nums
        <%= profile.score >= 7 ? 'bg-green-100 text-green-800' :
            profile.score >= 5 ? 'bg-yellow-100 text-yellow-800' :
                                 'bg-red-100 text-red-800' %>">
        <%= profile.score %>/10
      </span>
    <% end %>

    <span class="rounded-full px-2.5 py-1 text-xs font-medium
      <%= enrollment.convocado?  ? 'bg-amber-100 text-amber-800'  :
          enrollment.confirmado? ? 'bg-blue-100 text-blue-800'    :
          enrollment.asistio?    ? 'bg-green-100 text-green-800'  :
                                   'bg-slate-100 text-slate-500'  %>">
      <%= enrollment.status.capitalize %>
    </span>
    <% if enrollment.second_wave? %>
      <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">🌐 2da ola</span>
    <% end %>

    <% if policy(enrollment).mark_attendance? && !enrollment.asistio? && !enrollment.cancelado? %>
      <%= button_to mark_attendance_event_enrollment_path(event, enrollment), method: :patch,
            class: "flex items-center gap-1 rounded-lg bg-wine-800 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-wine-700 transition-colors cursor-pointer" do %>
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        Asistencia
      <% end %>
    <% end %>
  </div>
</div>
