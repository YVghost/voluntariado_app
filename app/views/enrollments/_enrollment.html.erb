<div id="<%= dom_id enrollment %>">
  <div>
    <strong>User:</strong>
    <%= enrollment.user_id %>
  </div>

  <div>
    <strong>Event:</strong>
    <%= enrollment.event_id %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= enrollment.status %>
  </div>

  <div>
    <strong>Check in time:</strong>
    <%= enrollment.check_in_time %>
  </div>

  <div>
    <strong>Latitude:</strong>
    <%= enrollment.latitude %>
  </div>

  <div>
    <strong>Longitude:</strong>
    <%= enrollment.longitude %>
  </div>

</div>
