<%= form_with(model: enrollment, class: "space-y-5") do |form| %>
  <% if enrollment.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-semibold mb-1"><%= pluralize(enrollment.errors.count, "error") %> al guardar:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% enrollment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :event_id, "Evento", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.collection_select :event_id,
          Event.includes(:organization).order(:title),
          :id,
          ->(e) { "#{e.title} — #{e.organization.name}" },
          { prompt: "Seleccioná un evento" },
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm
                  text-slate-800 focus:outline-none focus:ring-2 focus:ring-wine-300
                  focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :user_id, "Voluntario", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.collection_select :user_id,
          User.where(role: :voluntario).order(:name),
          :id,
          :name,
          { prompt: "Seleccioná un voluntario" },
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm
                  text-slate-800 focus:outline-none focus:ring-2 focus:ring-wine-300
                  focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.label :status, "Estado", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= form.select :status,
          Enrollment.statuses.keys.map { |s| [s.capitalize, s] },
          { selected: enrollment.status || "inscrito" },
          class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm
                  text-slate-800 focus:outline-none focus:ring-2 focus:ring-wine-300
                  focus:border-wine-400 transition" %>
  </div>

  <div>
    <%= form.submit class: "rounded-lg bg-wine-800 px-5 py-2 text-sm font-semibold text-white
                            hover:bg-wine-700 transition-colors cursor-pointer" %>
  </div>
<% end %>
